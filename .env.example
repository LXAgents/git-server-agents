# "prod" selects PostgreSQL (prisma/schema.prod.prisma); empty or "dev" selects SQLite.
PROD=dev
# Required when PROD=prod.
DATABASE_URL=postgresql://user:password@localhost:5432/git_server_agents

PORT=3000
# This server's public address, used to build OAuth callback URLs. Empty = the request's host.
PUBLIC_URL=

# Webhook authenticity. Required when PROD=prod; unsigned requests are accepted in dev only.
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# GitHub App. The client ID and private key mint installation tokens; the client ID and secret
# power "Continue with GitHub" (callback: <PUBLIC_URL>/api/auth/github/callback). The PEM may use literal \n.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com
GITHUB_URL=https://github.com

# GitLab OAuth application for "Continue with GitLab" (scope read_api,
# callback: <PUBLIC_URL>/api/auth/gitlab/callback).
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# GitLab bot token (api scope) used to read merge request diffs and post notes.
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
# Web address for OAuth; defaults to GITLAB_API_URL without /api/v4.
GITLAB_URL=

# 32-byte key that encrypts AccountKey.apiKeyEncrypted. Generate with:
#   node scripts/manage.js new-encryption-key
ENCRYPTION_KEY=

# Suggested model, shown in logs. Comments must name their model on line 1 (@vendor/model);
# comments without one are not answered.
DEFAULT_MODEL=openrouter/free
MAX_DIFF_CHARS=100000

# Run the worker inside the server process (default) or separately with `npm run worker`.
WORKER_INLINE=true
WORKER_POLL_MS=5000
# Comments answered at once, and the time limits (ms) for one model call, one whole answer,
# and each GitHub/GitLab API call.
WORKER_CONCURRENCY=4
MODEL_TIMEOUT_MS=60000
TASK_TIMEOUT_MS=240000
PLATFORM_TIMEOUT_MS=30000

# The one numeric GitHub / GitLab user ID that owns each platform (a list is refused).
GITHUB_ADMIN_ID=
GITLAB_ADMIN_ID=
# Comma-separated origins allowed to call the admin and user APIs (the dashboard).
CORS_ORIGINS=http://localhost:5173
