# "prod" selects PostgreSQL (prisma/schema.prod.prisma); empty or "dev" selects SQLite.
PROD=dev
# Required when PROD=prod.
DATABASE_URL=postgresql://user:password@localhost:5432/git_server_agents

PORT=3000

# Webhook authenticity. Required when PROD=prod; unsigned requests are accepted in dev only.
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# GitHub App credentials, used to mint installation tokens. The PEM may use literal \n.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com

# GitLab bot token (api scope) used to read merge request diffs and post notes.
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# 32-byte key that encrypts AccountKey.apiKeyEncrypted. Generate with:
#   node scripts/manage.js new-encryption-key
ENCRYPTION_KEY=

# Model used when line 1 of a comment does not start with @vendor/model.
DEFAULT_MODEL=openrouter/auto
MAX_DIFF_CHARS=100000

# Run the worker inside the server process (default) or separately with `npm run worker`.
WORKER_INLINE=true
WORKER_POLL_MS=5000

# Operator token for /api/admin (send as "Authorization: Bearer <token>"). Unset = admin API closed.
ADMIN_TOKEN=
# Comma-separated origins allowed to call the admin and user APIs (the dashboard).
CORS_ORIGINS=http://localhost:5173
