datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  type          String
  id            String
  // Lower case. "owner" runs the deployment; everyone else is "member" for now.
  role          String            @default("free")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  keys          AccountKey[]
  installations AppInstallation[]
  models        ModelSetting[]

  @@id([type, id])
}

model Provider {
  id          String       @id @default(cuid())
  displayName String
  url         String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  keys        AccountKey[]
}

model AccountKey {
  id                String           @id @default(cuid())
  accountType       String?
  accountId         String?
  appInstallationId String?
  repositoryId      String?
  providerId        String
  apiKeyEncrypted   String
  isActive          Boolean          @default(true)
  priority          Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  account           Account?         @relation(fields: [accountType, accountId], references: [type, id], onDelete: Cascade)
  appInstallation   AppInstallation? @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  repository        Repository?      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  provider          Provider         @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([accountType, accountId])
  @@index([appInstallationId])
  @@index([repositoryId])
}

model AppInstallation {
  id             String       @id @default(cuid())
  platform       String
  orgName        String
  installationId String?
  accountType    String
  accountId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        Account        @relation(fields: [accountType, accountId], references: [type, id], onDelete: Cascade)
  keys           AccountKey[]
  repositories   Repository[]
  models         ModelSetting[]

  @@unique([platform, orgName])
}

// A repository (GitHub) or project (GitLab) inside an imported org, added by one of its
// admins so it can have its own model and keys. externalId is the platform's numeric id.
model Repository {
  id                String          @id @default(cuid())
  platform          String
  externalId        String
  fullName          String
  appInstallationId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  appInstallation   AppInstallation @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  keys              AccountKey[]
  models            ModelSetting[]

  @@unique([platform, externalId])
  @@index([appInstallationId])
}

// The model a user, org or repo picks for one modality (text, image, ...). Exactly one owner
// is set.
model ModelSetting {
  id                String           @id @default(cuid())
  modality          String
  model             String
  accountType       String?
  accountId         String?
  appInstallationId String?
  repositoryId      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  account           Account?         @relation(fields: [accountType, accountId], references: [type, id], onDelete: Cascade)
  appInstallation   AppInstallation? @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  repository        Repository?      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([accountType, accountId])
  @@index([appInstallationId])
  @@index([repositoryId])
}

model AgentTask {
  id        String   @id @default(cuid())
  platform  String
  event     String
  status    String   @default("pending")
  payload   String
  errorLog  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Server log lines the owner reads on the dashboard's Logs page. Kept LOG_RETENTION_DAYS days.
model Log {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  platform  String?
  taskId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
