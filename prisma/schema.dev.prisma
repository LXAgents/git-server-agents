datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  type          String
  id            String
  // Lower case. "owner" runs the deployment; everyone else is "member" for now.
  role          String            @default("free")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  keys          AccountKey[]
  installations AppInstallation[]
  models        ModelSetting[]
  workspaceKeys WorkspaceKey[]

  @@id([type, id])
}

// One AI provider (OpenRouter, OpenAI, Anthropic, DeepSeek, z.ai), seeded by prisma/seed.js.
// slug is the name the API uses ("openai"). It is optional and not unique in the schema only
// so `db push` works on databases from before 1.13.0 without --accept-data-loss; the seed fills
// it and keeps one row per slug.
model Provider {
  id          String       @id @default(cuid())
  slug        String?
  displayName String
  url         String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  keys        AccountKey[]

  @@index([slug])
}

model AccountKey {
  id                String           @id @default(cuid())
  accountType       String?
  accountId         String?
  appInstallationId String?
  repositoryId      String?
  providerId        String
  apiKeyEncrypted   String
  isActive          Boolean          @default(true)
  priority          Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  account           Account?         @relation(fields: [accountType, accountId], references: [type, id], onDelete: Cascade)
  appInstallation   AppInstallation? @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  repository        Repository?      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  provider          Provider         @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([accountType, accountId])
  @@index([appInstallationId])
  @@index([repositoryId])
}

// A token for a development-environment provider (today only "github_codespaces": a GitHub
// personal access token with the codespace scope), brought by a user, an org or a repository
// like AccountKey. Exactly one owner is set. The token is stored encrypted (cryptoService) and
// decrypted only at the moment the agent calls the provider.
model WorkspaceKey {
  id                String           @id @default(cuid())
  provider          String
  tokenEncrypted    String
  priority          Int              @default(0)
  isActive          Boolean          @default(true)
  accountType       String?
  accountId         String?
  appInstallationId String?
  repositoryId      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  account           Account?         @relation(fields: [accountType, accountId], references: [type, id], onDelete: Cascade)
  appInstallation   AppInstallation? @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  repository        Repository?      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([appInstallationId])
  @@index([accountType, accountId])
}

model AppInstallation {
  id             String       @id @default(cuid())
  platform       String
  orgName        String
  installationId String?
  accountType    String
  accountId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        Account        @relation(fields: [accountType, accountId], references: [type, id], onDelete: Cascade)
  keys           AccountKey[]
  repositories   Repository[]
  models         ModelSetting[]
  workspaceKeys  WorkspaceKey[]

  @@unique([platform, orgName])
}

// A repository (GitHub) or project (GitLab) inside an imported org, added by one of its
// admins so it can have its own model and keys. externalId is the platform's numeric id.
model Repository {
  id                String          @id @default(cuid())
  platform          String
  externalId        String
  fullName          String
  appInstallationId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  appInstallation   AppInstallation @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  keys              AccountKey[]
  models            ModelSetting[]
  workspaceKeys     WorkspaceKey[]

  @@unique([platform, externalId])
  @@index([appInstallationId])
}

// The provider and model a user, org or repo picks for one modality (text, image, ...).
// Exactly one owner is set. provider is a Provider slug; rows from before 1.13.0 are OpenRouter.
model ModelSetting {
  id                String           @id @default(cuid())
  modality          String
  provider          String           @default("openrouter")
  model             String
  accountType       String?
  accountId         String?
  appInstallationId String?
  repositoryId      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  account           Account?         @relation(fields: [accountType, accountId], references: [type, id], onDelete: Cascade)
  appInstallation   AppInstallation? @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  repository        Repository?      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([accountType, accountId])
  @@index([appInstallationId])
  @@index([repositoryId])
}

model AgentTask {
  id        String   @id @default(cuid())
  platform  String
  event     String
  status    String   @default("pending")
  payload   String
  errorLog  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One conversation in a chat room (owen's chat_sessions table, fitted to the project). A room
// ("user:github:1001", "repo:<Repository id>", "org:<AppInstallation id>") holds many sessions.
// createdBy is "{platform}:{account id}" of whoever started it, or null for the agent's own
// activity session.
model ChatSession {
  id        String        @id @default(cuid())
  room      String
  title     String        @default("New Chat")
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([room, updatedAt])
}

// One stored message of a session (owen's chat_messages table). role is "user" or "assistant";
// type is "message" or "report". Progress and streamed tokens are live only and never stored.
model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  role        String
  type        String      @default("message")
  senderId    String?
  senderLogin String?
  // The poster's avatar URL, when the platform gave one.
  senderAvatar String?
  content     String
  // The event's data as JSON text, e.g. the model, provider, cost and token counts of an answer.
  data        String?
  createdAt   DateTime    @default(now())
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Server log lines the owner reads on the dashboard's Logs page. Kept LOG_RETENTION_DAYS days.
model Log {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  platform  String?
  taskId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
